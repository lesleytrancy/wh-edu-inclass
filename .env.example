DOUBAO_API_KEY=
# 工具类 Agent：填写思考型模型 ID 或推理接入点 ID
DOUBAO_THINKING_MODEL=
DOUBAO_THINKING_REASONING_EFFORT=high
DOUBAO_THINKING_TIMEOUT_SECONDS=210
# 对话与截图出题：填写支持视觉理解的豆包 Flash 模型接入点
DOUBAO_FLASH_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：未配置时仍可使用本地资料问答
BOCHA_API_KEY=
CORS_ORIGINS=http://localhost:5173

# 控制台导入30人模拟课堂时使用的随机种子。
CLASSROOM_SIMULATION_SEED=20261010
